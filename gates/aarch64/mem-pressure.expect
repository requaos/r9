#!/usr/bin/expect -f
# mem-pressure.expect — the aarch64 small-memory pressure driver (phase 05,
# MEM-10/MEM-15/MEM-16/MEM-17, D-17).
#
# smoke-r9.expect's discipline carried VERBATIM (fresh-capture hygiene,
# marker discipline, fast-fail arms, whole-capture post-passes, group-kill
# teardown) and re-keyed onto the constrained-pool pressure load:
#
#   * the caller patched /chosen/bootargs with `palloc_max_frames=2048`
#     (an 8 MiB bounded PAGE_ALLOC pool) and shrank /memory@40000000 to
#     256 MiB (the initrd at 0x48000000 sits inside), and launches QEMU
#     with `-smp 2` and `-m $R9_MEM` (default 256M) and `-dtb $env(R9_DTB)`.
#   * the driver asserts `palloc: managed_frames=2048` at boot, then drives
#     from Harvey's rc shell:
#       `hseq 1 44000 | hsort > /dev/null` (R9_PRESSURE_LINES).  This
#       BOUNDED burst is sized so hsort's line table + sort recursion needs
#       more frames than the pool has dirty+clean (the live evictor runs:
#       measured evict_calls=4), while the total demand stays inside the
#       reclaimable (cold, unmapped) part of `palloc.hash` (measured
#       reclaimed=64 of ~111), so every allocation succeeds and no process
#       is killed.  The earlier unbounded `hseq 1 400000` burst demanded
#       ~100x the pool and could only thrash (the 05-21 measurement); the
#       exec-churn loop it replaced never exhausted the pool at all.
#   * re-fault: re-run `cat /lib/namespace` and require its known line —
#     the evicted binary/data pages fault back byte-identically through
#     palloc.hash.
#   * `cat '#c/sysstat'` (read-only, served by port/src/devcons.rs from
#     port::palloc::evictor_stats()) → parse
#     `evictor: dropped_text=<T> dropped_data=<D> pinned_skipped=<P>
#      evict_calls=<C> reclaimed=<R> free_failures=<F>` and require
#     T > 0, D > 0, C > 0, R > 0 and F == 0 — the live evictor ran,
#     reclaimed BOTH text and untouched-data pages, and every victim's
#     frame reached PAGE_ALLOC.
#
#     `pinned_skipped` is REPORTED but NOT asserted.  The 05-21 finding
#     (05-21-SUMMARY BLOCKER 3) is structural: writable user buffers are
#     promoted off the droppable queue and the only read-only user slice
#     is a stack/.bss page that never enters palloc.hash, so no userland
#     path in this image can present a pinned CACHED page to the evictor.
#     Asserting P > 0 asserted something the architecture cannot produce.
#     Pinning is proven instead by the host integration test
#     `port/src/pagecache.rs::pinned_cached_page_is_skipped_until_unpinned`,
#     which pins a real cached frame through `PageAlloc::pin_frame` (the
#     exact call `UserSlice`'s PinGuard makes) and requires the evictor to
#     skip it, count `pinned_skipped`, and take it once unpinned.  The old
#     background pinned-reader pipeline is gone with that criterion: it
#     could never pin a cached page, it changed the pressure baseline by
#     starting extra shells, and every stage it added was another
#     exec-after-pressure surface the gate does not need.
#   * the whole capture must be free of `phys page alloc failed` — that
#     allocation failure is the 05-21 defect this gate exists to catch.
#
#   exit 0 only when EVERY stage passed; exit 1 names the failed stage on
#   stderr; exit 2 on a contract violation (missing env).
#
# Hygiene: the caller rm -f's the capture BEFORE launch and we rm -f +
# log_file it fresh below; every exit path kills qemu's process group.
#
# Markers: PRESENCE assertions only, never interleaving order.  The devcons
# ECHOES cooked-mode typed input, so typed-text markers are staged
# two-occurrence.  Typed lines are kept SHORT (the 16550 RX-ring limit).
#
# Env (exported by nix/gates/mem-pressure-r9.sh — the flake app):
#   R9_QEMU      default qemu-system-aarch64
#   R9_KERNEL    REQUIRED — the r9 kernel-virt.elf
#   R9_DTB       REQUIRED — the patched virt DTB copy (memory + bootargs)
#   R9_INITRD    REQUIRED — target/images/aarch64/bootfs.paq
#   R9_SMOKE_LOG REQUIRED — the serial capture (fresh per run)
#   R9_MEM       guest RAM (default 256M)
#   R9_PALLOC_MAX_FRAMES  the managed-frame cap (default 2048)
#   R9_PRESSURE_LINES     the bounded burst's line count (default 40000;
#                         measured on HVF and TCG: evict_calls=4,
#                         reclaimed=64, dropped_text=29, dropped_data=35)
#
# usage: env R9_KERNEL=… R9_DTB=… R9_INITRD=… R9_SMOKE_LOG=… \
#          expect gates/aarch64/mem-pressure.expect
# exit 0 on all-pass; exit 1 names the failed stage on stderr; exit 2 on a
# contract violation (missing env).

set timeout 600                    ;# TCG-sized, PER STAGE
match_max 262144
# NOTE: log_user stays ON — expect 5.45 writes NOTHING to log_file when
# log_user is 0 (measured: the capture file was created empty).

# --- required env (loud, before any spawn) -------------------------------
foreach v {R9_KERNEL R9_DTB R9_INITRD R9_SMOKE_LOG} {
    if {![info exists env($v)]} {
        puts stderr "mem-pressure-r9: \$$v unset — run via the flake app (nix run .#mem-pressure-r9)"
        exit 2
    }
}
set QEMU [expr {[info exists env(R9_QEMU)] ? $env(R9_QEMU) : "qemu-system-aarch64"}]
set run_tag [expr {[info exists env(R9_RUN_TAG)] ? $env(R9_RUN_TAG) : "r9mempress-[pid]-[clock seconds]"}]
set r9_mem [expr {[info exists env(R9_MEM)] ? $env(R9_MEM) : "256M"}]
set maxf [expr {[info exists env(R9_PALLOC_MAX_FRAMES)] ? $env(R9_PALLOC_MAX_FRAMES) : 2048}]
set pressure_lines [expr {[info exists env(R9_PRESSURE_LINES)] ? $env(R9_PRESSURE_LINES) : 40000}]

# --- Hygiene: a fresh capture per run -----------------------------------
exec rm -f $env(R9_SMOKE_LOG)

# --- spawn qemu: -smp 2, small RAM, the caller-patched DTB --------------
set R9_MACHINE [expr {[info exists env(R9_MACHINE)] ? $env(R9_MACHINE) : "virt,gic-version=3"}]
set R9_CPU [expr {[info exists env(R9_CPU)] ? $env(R9_CPU) : "cortex-a72"}]
set R9_ACCEL [expr {[info exists env(R9_ACCEL)] ? $env(R9_ACCEL) : "tcg"}]
spawn $QEMU -M $R9_MACHINE -cpu $R9_CPU -smp 2 -m $r9_mem \
    -accel $R9_ACCEL \
    -kernel $env(R9_KERNEL) \
    -dtb $env(R9_DTB) \
    -device loader,file=$env(R9_INITRD),addr=0x48000000 \
    -netdev user,id=n0 \
    -device virtio-net-pci-non-transitional,netdev=n0 \
    -nographic \
    -name $run_tag
set spawn_pid [exp_pid]
log_file $env(R9_SMOKE_LOG)

# --- teardown: kill qemu's process group ------------------------------
proc cleanup {} {
    global spawn_pid
    catch { exec kill -KILL -- -$spawn_pid 2>/dev/null }
    catch { exec kill -KILL $spawn_pid 2>/dev/null }
}

# --- staged ordered assertions (each stage names its failure) ---------
proc stage {name re} {
    global expect_out
    expect {
        -re $re { puts stderr "mem-pressure-r9: stage ok — $name" }
        timeout { puts stderr "mem-pressure-r9: TIMEOUT at stage: $name"; cleanup; exit 1 }
        eof { puts stderr "mem-pressure-r9: qemu exited (EOF) at stage: $name"; cleanup; exit 1 }
    }
}

# fast-fail on any deadlock/panic/rank vocabulary anywhere on the wire.
expect_before {
    -re {WATCHDOG:|panic|lock rank|unresolvable fault} {
        puts stderr "mem-pressure-r9: FATAL marker on the wire (WATCHDOG/panic/lock-rank/unresolvable-fault) — aborting"
        cleanup
        exit 1
    }
}

proc strip_echoed_line {capture} {
    set nl [string first "\n" $capture]
    if {$nl < 0} { return $capture }
    string range $capture [expr {$nl + 1}] end
}

proc whole_capture_clean {} {
    global env
    log_file                           ;# stop + flush before the whole-file scan
    set fh [open $env(R9_SMOKE_LOG) r]
    set whole [read $fh]
    close $fh
    foreach bad {"WATCHDOG:" "panic" "lock rank" "unresolvable fault" "phys page alloc failed"} {
        if {[string first $bad $whole] >= 0} {
            puts stderr "mem-pressure-r9: FAILED — forbidden marker '$bad' in the capture"
            cleanup
            exit 1
        }
    }
    puts stderr "mem-pressure-r9: post-pass ok — no WATCHDOG/panic/lock-rank/unresolvable-fault/alloc-failure in the capture"
}

# --- 1. the staged boot (markers in emission order) -------------------
# The managed-frame cap is read by palloc at memory init, BEFORE the
# secondary CPU comes online (05-21: fixed the 05-27 ordering bug — the
# palloc marker prints at ~line 49, smp-online at ~line 1855).
stage banner    {r9 from the Internet}
stage palloc    "palloc: managed_frames=$maxf"
stage smp-online {smp: cpu 1 online}
stage paqfs     {paqfs\.\.\.}
stage prompt    {% }

# --- 2. the BOUNDED pressure burst (2 CPUs: hseq | hsort) -------------
# hseq's stream + hsort's line table and sort recursion need more frames
# than the pool's dirty+clean headroom, so alloc_clean reaches the live
# evictor; the total stays inside the cold (unmapped) part of palloc.hash,
# so reclaim keeps every allocation satisfied and no process is killed.
send "hseq 1 $pressure_lines | hsort > /dev/null\r"
stage pressure-prompt {% }

# --- 3. re-fault: the evicted binary/data pages fault back identically -
send "cat /lib/namespace\r"
stage refault-prompt {% }
set rf [strip_echoed_line $expect_out(buffer)]
if {![string match "*bind -c #e /env*" $rf]} {
    puts stderr "mem-pressure-r9: re-fault FAILED — cat /lib/namespace lost its known line after pressure (evicted pages did not fault back intact)"
    cleanup
    exit 1
}
puts stderr "mem-pressure-r9: stage ok — re-fault (known line intact after pressure)"

# --- 4. read #c/sysstat and assert the live-evictor result ------------
send "cat '#c/sysstat'\r"
stage sysstat-prompt {% }
set ss [strip_echoed_line $expect_out(buffer)]
if {![regexp {evictor: dropped_text=(\d+) dropped_data=(\d+) pinned_skipped=(\d+) evict_calls=(\d+) reclaimed=(\d+) free_failures=(\d+)} $ss -> t d p c r f]} {
    puts stderr "mem-pressure-r9: #c/sysstat did not print the evictor line (got: $ss)"
    cleanup
    exit 1
}
puts stderr "mem-pressure-r9: sysstat — dropped_text=$t dropped_data=$d pinned_skipped=$p evict_calls=$c reclaimed=$r free_failures=$f"
# The pool was genuinely exhausted (evict_calls > 0), the live evictor
# reclaimed re-readable text AND untouched data, and every reclaimed frame
# reached PAGE_ALLOC (free_failures == 0).  pinned_skipped is reported but
# not asserted: no userland path in this image can pin a cached page (the
# 05-21 structural finding); pinning is proven by the host integration test
# port/src/pagecache.rs::pinned_cached_page_is_skipped_until_unpinned.
if {$t <= 0 || $d <= 0 || $c <= 0 || $r <= 0 || $f != 0} {
    puts stderr "mem-pressure-r9: evictor result wrong (dropped_text=$t dropped_data=$d evict_calls=$c reclaimed=$r free_failures=$f) — want text>0, data>0, calls>0, reclaimed>0, free_failures==0"
    cleanup
    exit 1
}
puts stderr "mem-pressure-r9: stage ok — live evictor reclaimed text+data under real exhaustion"

# --- 5. the completion marker -----------------------------------------
send "echo MEM_PRESSURE_OK\r"
stage done-echoed   {MEM_PRESSURE_OK}   ;# occurrence 1: the typed echo
stage done-response {MEM_PRESSURE_OK}   ;# occurrence 2: the OUTPUT
stage done-prompt   {% }

# --- 6. whole-capture post-pass ---------------------------------------
whole_capture_clean

puts stderr "mem-pressure-r9: ALL STAGES PASS — 8 MiB pool boot, bounded burst reclaims text+data, byte-identical re-fault, MEM_PRESSURE_OK"
cleanup
exit 0
