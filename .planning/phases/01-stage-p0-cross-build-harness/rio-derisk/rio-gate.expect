#!/usr/bin/expect -f
# rio-gate.expect — plan 01-09's fixed headless rio proof (D-28).
#
# Rewired from spike S3's `rio-gate.expect` (itself a rewiring of Harvey
# bd7a6982a's `build/x86_64/drawterm-gate.expect`).  The chassis is kept
# (qemu under the emitter's slirp argv, the boot ladder to cpurc: DONE,
# the hostfwd listener observation, the run-tag teardown, the redaction
# post-pass).  Two things change, both from rio-derisk/RIO-DERISK.md:
#
#   * rio mode feeds the password through the X11 keyboard path.  Under
#     X11 drawterm reads /dev/cons from kbdq, fed only by X key events
#     (gui-x11/x11.c: xkeyboard -> kbdputc(kbdq)); the host pty reader
#     exists only with -G (main.c: gconsinit).  The driver waits for the
#     drawterm window (WM class drawterm; the window never carries
#     _NET_WM_PID, so `xdotool search --pid' cannot work), focuses it and
#     types the password from the 0600 file with XTEST, then Return.
#   * the password value is read from R9_DT_PWFILE, never from the
#     environment; the shell keeps it in one 0600 file removed by its
#     EXIT trap.
#
#   RIO_MODE=rio
#     drawterm runs WITHOUT -G against the Xvfb DISPLAY exported by
#     rio-gate.sh, so the cpu profile sees /mnt/term/dev/draw and runs
#     `plumber; exec rio'.  The driver then owns the qemu serial
#     console (init hands it an interactive rc after cpurc: DONE, so
#     `init: starting /bin/rc' then a `% ' prompt), types `ls /srv'
#     there, and requires BOTH `riowctl.<user>.<pid>' and
#     `rio.<user>.<pid>' in the listing.  Success prints RIO-SERVING.
#     Named failures: RIO-FAIL rio-not-serving (no entries within the
#     budget), RIO-FAIL dt-feed-timeout (no window or no XTEST type
#     within the feed budget), RIO-FAIL drawterm-exited, RIO-FAIL
#     no-session.
#
#   RIO_MODE=rio-diag
#     The rio leg plus the diagnostic evidence (plan 01-32).  The gate
#     patched the scratch cpu profile to create /srv/r9-login-ok and
#     /srv/r9-login-pid.<pid> (unposted #s service entries) immediately
#     before `exec rio'; this driver parses the serial `ls /srv' listing
#     for those entries and prints `RIO-DIAG login-ok' when the login
#     reached the profile's rio handoff, or `RIO-FAIL login-not-reached'
#     when it did not.  It then runs the UNCHANGED pair poll and prints
#     RIO-SERVING / RIO-FAIL rio-not-serving, so one run yields both the
#     login and the rio-start verdicts.  Before typing and after Return
#     it captures the drawterm window identity, geometry and focus plus
#     xprop/xwininfo into $RIO_OUT/x11.txt, and one PNG each into
#     $RIO_OUT/ (diag-capture is a named failure: no run without
#     evidence).  The marker is presence-only — devsrv's create is
#     OWRITE-only and its write expects a decimal fd, so an unposted
#     entry can be listed but not read (port/src/devsrv.rs).  The
#     diagnostic is NOT a gate: a PASS (exit 0) still requires the D-28
#     pair.
#
#   RIO_MODE=control-noG
#     The same pipeline with -G (no draw device), so the profile must
#     skip rio.  The unchanged pty password feed applies (gconsinit's
#     stdin reader is the -G path).  The driver waits for the cpu% shell
#     prompt, types `ls /srv' on the serial console and requires NO
#     `rio.' entry.  Success prints RIO-CONTROL-NO-RIO; a rio entry
#     prints RIO-FAIL control-saw-rio and exits non-zero.
#
# The login name is RIO_DT_USER (default glenda in rio-gate.sh): only
# /usr/glenda/lib/profile is staged, and rcmain sources a profile only
# when `rc -li' runs as a user whose $home/lib/profile is readable.  The
# DEMO domain's users share one password, so the creds file's password
# still authenticates glenda.  The prompt is `glenda@DEMO-harvey
# password: ', not `glenda@glenda' (the domain is the nvram authdom).
#
# Env (rio-gate.sh exports all of it):
#   R9_QEMU / R9_ISO / RIO_SMOKE_LOG / R9_NETDEV_ARGV / R9_ACCEL /
#   R9_MACHINE / R9_CPU — the chassis, unchanged.
#   R9_DEMO_USER — the creds file's user name (norbert on DEMO), for
#   failure messages only.
#   R9_CREDS_FILE — the creds file path, for failure messages only.
#   R9_DT_PWFILE — the 0600 password file; the only password source.
#   DRAWTERM_BIN — Harvey's drawterm package binary (X11 backend).
#   DISPLAY — the private Xvfb display (rio mode).
#   RIO_MODE — rio | control-noG | rio-diag.
#   RIO_DT_USER — the drawterm -O user (glenda).
#   RIO_RIO_BUDGET / RIO_SESSION_WINDOW / RIO_SRV_POLLS /
#   RIO_SRV_POLL_WAIT / RIO_FEED_WAIT / RIO_FEED_SETTLE — the stage
#   budgets (see rio-gate.sh).
#   RIO_OUT — the output dir; required only for rio-diag (x11.txt and the
#   two PNGs land there).
#   RIO_DIAG_MARKER — the serial marker entry name (rio-diag only).
#   RIO_DIAG_PID_PREFIX — the pid-entry name prefix (rio-diag only).
#   R9_RUN_TAG / R9_DT_TAG — the per-run survivor-sweep identities.
#
# exit 0 only when the mode's assertion passed; exit 1 names the failed
# stage on stderr; exit 2 on a contract violation (missing/empty env).

set timeout 600                    ;# per boot stage, TCG-sized
match_max 1048576
# log_user stays ON — expect writes nothing to log_file when log_user is 0

# --- required env (loud, BEFORE any spawn) -----------------------------
set creds_file [expr {[info exists env(R9_CREDS_FILE)] ? $env(R9_CREDS_FILE) : "build/x86_64/out/auth-creds.txt"}]
foreach v {R9_ISO RIO_SMOKE_LOG R9_NETDEV_ARGV R9_DEMO_USER R9_DT_PWFILE DRAWTERM_BIN RIO_DT_USER RIO_MODE} {
	if {[info exists env($v)]} {
		if {$env($v) eq ""} {
			puts stderr "rio-gate: \$$v is EMPTY — aborting before any spawn; the creds read names the file: $creds_file"
			exit 2
		}
		continue
	}
	puts stderr "rio-gate: \$$v unset — run via the flake app (nix run ...#rio-gate)"
	exit 2
}
if {$env(RIO_MODE) ni {rio control-noG rio-diag}} {
	puts stderr "rio-gate: RIO_MODE=$env(RIO_MODE) — want rio|control-noG|rio-diag"
	exit 2
}
set diag_mode [expr {$env(RIO_MODE) eq "rio-diag"}]
set rio_mode [expr {$env(RIO_MODE) eq "rio" || $diag_mode}]
set dt_user $env(RIO_DT_USER)
if {![file readable $env(R9_DT_PWFILE)]} {
	puts stderr "rio-gate: the 0600 password file $env(R9_DT_PWFILE) is not readable — aborting before any spawn"
	exit 2
}
set pwfh [open $env(R9_DT_PWFILE) r]
set dt_pw [string trimright [read $pwfh] "\r\n"]
close $pwfh
if {$dt_pw eq ""} {
	puts stderr "rio-gate: the 0600 password file is empty — aborting before any spawn"
	exit 2
}
if {![file executable $env(DRAWTERM_BIN)]} {
	puts stderr "rio-gate: DRAWTERM_BIN $env(DRAWTERM_BIN) is not an executable file"
	exit 2
}
if {$rio_mode && ![info exists env(DISPLAY)]} {
	puts stderr "rio-gate: RIO_MODE=rio but DISPLAY is unset — the XTEST feed has no display"
	exit 2
}
if {$diag_mode} {
	foreach v {RIO_OUT RIO_DIAG_MARKER RIO_DIAG_PID_PREFIX} {
		if {![info exists env($v)] || $env($v) eq ""} {
			puts stderr "rio-gate: RIO_MODE=rio-diag but \$$v is unset/empty — the diagnostic cannot record its marker/evidence"
			exit 2
		}
	}
	# The diagnostic must never fall back to a run without evidence: name
	# the capture tools before anything spawns (nothing to clean up yet).
	set have_convert [expr {[auto_execok convert] ne ""}]
	set have_magick [expr {[auto_execok magick] ne ""}]
	set have_import [expr {[auto_execok import] ne ""}]
	if {[auto_execok xwd] eq "" || (!$have_convert && !$have_magick && !$have_import)} {
		puts stderr "RIO-FAIL diag-capture — xwd plus one of convert|magick|import is required for the PNG evidence (the flake app's runtimeInputs carry them)"
		exit 1
	}
	foreach tool {xprop xwininfo} {
		if {[auto_execok $tool] eq ""} {
			puts stderr "RIO-FAIL diag-capture — $tool is required for x11.txt (the flake app's runtimeInputs carry it)"
			exit 1
		}
	}
}
set QEMU [expr {[info exists env(R9_QEMU)] ? $env(R9_QEMU) : "qemu-system-x86_64"}]
set run_tag [expr {[info exists env(R9_RUN_TAG)] ? $env(R9_RUN_TAG) : "r9riogate-[pid]-[clock seconds]"}]
set dt_tag [expr {[info exists env(R9_DT_TAG)] ? $env(R9_DT_TAG) : "r9riogate-dt-[pid]-[clock seconds]"}]
set rio_budget [expr {[info exists env(RIO_RIO_BUDGET)] ? $env(RIO_RIO_BUDGET) : 60}]
set session_window [expr {[info exists env(RIO_SESSION_WINDOW)] ? $env(RIO_SESSION_WINDOW) : 30}]
set srv_polls [expr {[info exists env(RIO_SRV_POLLS)] ? $env(RIO_SRV_POLLS) : 12}]
set srv_poll_wait [expr {[info exists env(RIO_SRV_POLL_WAIT)] ? $env(RIO_SRV_POLL_WAIT) : 5}]
set feed_wait [expr {[info exists env(RIO_FEED_WAIT)] ? $env(RIO_FEED_WAIT) : 30}]
set feed_settle [expr {[info exists env(RIO_FEED_SETTLE)] ? $env(RIO_FEED_SETTLE) : 2}]

# --- Hygiene: a fresh capture per run ----------------------------------
exec rm -f $env(RIO_SMOKE_LOG)
if {$diag_mode} {
	# Fresh diagnostic artifacts too: an appended x11.txt from a prior
	# run would corrupt the before/after labels.
	foreach stale {x11.txt drawterm-before-typing.png drawterm-after-return.png} {
		catch {exec rm -f [file join $env(RIO_OUT) $stale]}
	}
}

# --- subtree 1: qemu with the cpu ISO ----------------------------------
set R9_MACHINE [expr {[info exists env(R9_MACHINE)] ? $env(R9_MACHINE) : "q35"}]
set R9_CPU [expr {[info exists env(R9_CPU)] ? $env(R9_CPU) : "host"}]
set R9_ACCEL [expr {[info exists env(R9_ACCEL)] ? $env(R9_ACCEL) : "kvm"}]

set netdev_argv {}
foreach tok [split $env(R9_NETDEV_ARGV)] {
	if {$tok ne ""} {
		lappend netdev_argv $tok
	}
}
if {[llength $netdev_argv] == 0} {
	puts stderr "rio-gate: R9_NETDEV_ARGV is empty — the caller's emitter capture failed"
	exit 2
}

spawn $QEMU -M $R9_MACHINE -cpu $R9_CPU -smp 1 -m 1024M \
	-accel $R9_ACCEL \
	-cdrom $env(R9_ISO) \
	{*}$netdev_argv \
	-nographic \
	-name $run_tag
set qemu_sid $spawn_id
set qemu_pid [exp_pid]
log_file $env(RIO_SMOKE_LOG)

# --- teardown: kill BOTH process groups on every exit path --------------
proc cleanup {} {
	global qemu_pid
	catch { exec kill -KILL -- -$qemu_pid 2>/dev/null }
	catch { exec kill -KILL $qemu_pid 2>/dev/null }
	if {[info exists ::dt_pid]} {
		catch { exec kill -KILL -- -$::dt_pid 2>/dev/null }
		catch { exec kill -KILL $::dt_pid 2>/dev/null }
	}
}

# --- staged ordered assertions -----------------------------------------
proc stage {name re} {
	expect {
		-re $re { puts stderr "rio-gate: stage ok — $name" }
		timeout { puts stderr "rio-gate: TIMEOUT at stage: $name"; cleanup; exit 1 }
		eof { puts stderr "rio-gate: process exited (EOF) at stage: $name"; cleanup; exit 1 }
	}
}

proc feedstage {name re sendstr} {
	expect {
		-re $re { send -- $sendstr; puts stderr "rio-gate: feed ok — $name" }
		timeout { puts stderr "rio-gate: TIMEOUT at feed stage: $name"; cleanup; exit 1 }
		eof { puts stderr "rio-gate: process exited (EOF) at feed stage: $name"; cleanup; exit 1 }
	}
}

# --- hostfwd listener observation (the chassis hostfwd_stage) ----------
proc host_listeners {} {
	if {![catch {exec ss -tln} out]} { return $out }
	if {![catch {exec netstat -tln} out]} { return $out }
	return ""
}
proc hostfwd_stage {port} {
	set listeners [host_listeners]
	if {$listeners eq ""} {
		puts stderr "rio-gate: FAILED at stage: hostfwd-$port-listening — no host listening-table tool produced output"
		cleanup
		exit 1
	}
	if {![regexp "127\\.0\\.0\\.1:${port}( |\$)" $listeners]} {
		puts stderr "rio-gate: FAILED at stage: hostfwd-$port-listening — no 127.0.0.1:$port loopback entry (the slirp hostfwd bind is missing); table follows:"
		puts stderr $listeners
		cleanup
		exit 1
	}
	puts stderr "rio-gate: stage ok — hostfwd-$port-listening (127.0.0.1:$port present)"
}

# --- the X11 password feed (rio mode only) -----------------------------
# drawterm sets WM_NAME "drawterm" and WM_CLASS res_name "drawterm" /
# res_class "Drawterm" (gui-x11/x11.c: XSetWMProperties) but never sets
# _NET_WM_PID, so xdotool's --pid lookup cannot match it.  The Xvfb
# display is private to this run, so the class is unique.  `timeout'
# bounds xdotool's --sync wait; a failure names dt-feed-timeout.  The
# wait and the type are separate procs so the diagnostic can capture the
# window between them (before any keystroke) and again after Return.
proc xwait_window {wait} {
	if {[catch {exec timeout $wait xdotool search --sync --onlyvisible --classname {^drawterm$}} out]} {
		return -code error "window-wait-failed"
	}
	set wid [lindex [split [string trim $out] "\n"] 0]
	if {$wid eq "" || ![string is digit $wid]} {
		return -code error "window-id-unparsed"
	}
	return $wid
}

proc xfeed_type {wid secretfile settle} {
	if {[catch {exec xdotool windowfocus --sync $wid} out]} {
		return -code error "window-focus-failed"
	}
	# The prompt is drawn in the window, not readable here; keystrokes
	# typed after the window exists sit in kbdq until readcons consumes
	# them, so a short settle before typing is sufficient.
	after [expr {$settle * 1000}]
	if {[catch {exec xdotool type --clearmodifiers --delay 40 --file $secretfile} out]} {
		return -code error "xtest-type-failed"
	}
	if {[catch {exec xdotool key --clearmodifiers Return} out]} {
		return -code error "xtest-return-failed"
	}
	return $wid
}

# --- rio-diag: the X11 window evidence (diagnostic only) ---------------
# x11.txt gets the window identity, geometry, focus and WM properties
# before typing and after Return.  Each command's failure is recorded in
# place, never dropped silently; a missing TOOL is a diag-capture
# failure checked before any spawn.
proc diag_note {fh label args} {
	puts $fh "--- $label"
	if {[catch {exec {*}$args} out]} {
		puts $fh "(exec failed: $out)"
	} else {
		puts $fh $out
	}
}

proc diag_capture {tag wid fh} {
	global env
	puts $fh "== $tag (mode $env(RIO_MODE), display $env(DISPLAY))"
	diag_note $fh "xdotool search --onlyvisible --classname ^drawterm$" \
		xdotool search --onlyvisible --classname {^drawterm$}
	diag_note $fh "xdotool getwindowgeometry --shell $wid" \
		xdotool getwindowgeometry --shell $wid
	diag_note $fh "xdotool getwindowfocus" xdotool getwindowfocus
	diag_note $fh "xprop -id $wid WM_CLASS WM_NAME" xprop -id $wid WM_CLASS WM_NAME
	diag_note $fh "xwininfo -id $wid -tree" xwininfo -id $wid -tree
}

proc capture_png {wid path} {
	global have_convert have_magick have_import
	set tmp "$path.xwd"
	if {[catch {exec xwd -id $wid -out $tmp} out]} {
		catch {file delete -force $tmp}
		return -code error "xwd-failed: $out"
	}
	if {$have_convert} {
		set conv convert
	} elseif {$have_magick} {
		set conv magick
	} else {
		set conv ""
	}
	if {$conv ne ""} {
		if {[catch {exec $conv "xwd:$tmp" "png:$path"} out]} {
			catch {file delete -force $tmp}
			return -code error "$conv-failed: $out"
		}
		catch {file delete -force $tmp}
		return $path
	}
	# No ImageMagick converter named: `import' is the plan's fallback.
	catch {file delete -force $tmp}
	if {[catch {exec import -window $wid $path} out]} {
		return -code error "import-failed: $out"
	}
	return $path
}

# fast-fail on kernel panic markers and the cpurc FAIL vocabulary
expect_before {
	-re {panic|Unhandled interrupt} {
		puts stderr "rio-gate: kernel panic marker on the wire — aborting"
		cleanup
		exit 1
	}
	-re {cpurc: FAIL} {
		puts stderr "rio-gate: cpurc printed a FAIL marker — aborting (the failing leg is named on the wire)"
		cleanup
		exit 1
	}
}

# --- 1. the boot ladder (EMISSION order) --------------------------------
stage banner	{r9 from the Internet}
stage bootconf	{devenv: bootconf init=/amd64/init -c}
stage paqfs	{paqfs\.\.\.}
stage version	{version\.\.\.}

# --- 2. the hostfwd pair observed host-side ----------------------------
hostfwd_stage 17010
hostfwd_stage 5670

# --- 3. the cpurc ladder in EMISSION order -----------------------------
stage pairing-ok	{cpurc: PAIR-OK}
stage ether-ok		{cpurc: ETHER-OK}
stage keyfs-ok		{cpurc: KEYFS-OK}
stage authsrv-listen	{cpurc: AUTHSRV-LISTEN}
stage factotum-ok	{cpurc: FACTOTUM-OK}
stage listen-17010	{cpurc: LISTEN-17010}
stage ladder-done	{cpurc: DONE}

# --- 4. subtree 2: drawterm on a pty ------------------------------------
# rio mode drops -G so the client serves /dev/draw; the Xvfb DISPLAY is
# exported by rio-gate.sh.  The -s '' flag stays load-bearing (secstore
# probe avoidance, the 19-08 measured lesson).  The unique run identity
# rides argv[0] via bash's `exec -a' (drawterm rejects extra argv
# operands) and the environment (the teardown sweep's second key).
set dt_spec "cpu=127.0.0.1,auth=tcp!127.0.0.1!5670,user=$dt_user"
set dt_flags [expr {$rio_mode ? "" : "-G "}]
set dt_cmd "R9_RUN_ID=$dt_tag exec -a $dt_tag $env(DRAWTERM_BIN) $dt_flags-s '' -O $dt_spec"
spawn bash -c $dt_cmd
set dt_sid $spawn_id
set ::dt_pid [exp_pid]
puts stderr "rio-gate: spawned drawterm on a pty (mode $env(RIO_MODE), argv0 tag $dt_tag, user $dt_user)"
set spawn_id $dt_sid

# --- 5. the password feed ------------------------------------------------
if {$rio_mode} {
	# X11: XTEST keystrokes into the private Xvfb display.  The pty is
	# never fed here (no host-stdin reader exists without -G).
	if {[catch {xwait_window $feed_wait} wid]} {
		puts stderr "RIO-FAIL dt-feed-timeout — the X11 password feed did not complete ($wid; WM class drawterm on the private display, pwfile $env(R9_DT_PWFILE))"
		cleanup
		exit 1
	}
	if {$diag_mode} {
		set diag_x11 [file join $env(RIO_OUT) x11.txt]
		set diag_fh [open $diag_x11 a]
		puts $diag_fh "# rio-diag X11 evidence — drawterm window $wid on $env(DISPLAY) (plan 01-32)"
		diag_capture "before-typing" $wid $diag_fh
		if {[catch {capture_png $wid [file join $env(RIO_OUT) drawterm-before-typing.png]} err]} {
			close $diag_fh
			puts stderr "RIO-FAIL diag-capture — the before-typing PNG capture failed ($err)"
			cleanup
			exit 1
		}
		puts stderr "rio-gate: diag capture ok — before-typing x11 + PNG in $env(RIO_OUT)"
	}
	if {[catch {xfeed_type $wid $env(R9_DT_PWFILE) $feed_settle} err]} {
		if {$diag_mode} {
			diag_capture "feed-failed" $wid $diag_fh
			close $diag_fh
		}
		puts stderr "RIO-FAIL dt-feed-timeout — the X11 password feed did not complete ($err; WM class drawterm on the private display, pwfile $env(R9_DT_PWFILE))"
		cleanup
		exit 1
	}
	if {$diag_mode} {
		# A short settle so the after shot shows the post-Return state
		# (rio's first draw or the auth error).  Raw-mode readcons never
		# echoes the password, so no secret is ever on the screen.
		after 2000
		diag_capture "after-return" $wid $diag_fh
		if {[catch {capture_png $wid [file join $env(RIO_OUT) drawterm-after-return.png]} err]} {
			close $diag_fh
			puts stderr "RIO-FAIL diag-capture — the after-return PNG capture failed ($err)"
			cleanup
			exit 1
		}
		close $diag_fh
		puts stderr "rio-gate: diag capture ok — after-return x11 + PNG in $env(RIO_OUT)"
	}
	puts stderr "rio-gate: feed ok — XTEST password entry into the drawterm window ($wid)"

	# --- 6r. rio draws; the pty is quiet on success.  Watch the window
	#         for the two loud failures (a dead client, a pty EOF), then
	#         prove the session from the serial console.  A rejected
	#         password prints in the drawterm window, not the pty, so it
	#         surfaces as rio-not-serving after the serial budget.
	set timeout $session_window
	expect {
		-re {goodbye} {
			puts stderr "RIO-FAIL drawterm-exited — drawterm exited before rio started (goodbye on the pty)"
			cleanup
			exit 1
		}
		eof {
			puts stderr "RIO-FAIL drawterm-exited — drawterm died during the auth/session start (pty EOF)"
			cleanup
			exit 1
		}
		timeout {
			puts stderr "rio-gate: stage ok — session window quiet (rio draws; no pty text expected)"
		}
	}
} else {
	# --- 6c. control: the -G pty feed is the unchanged pass-1 path.
	set spawn_id $dt_sid
	feedstage dt-password "${dt_user}@.* password: " "$dt_pw\r"

	# The profile runs, sees no /dev/draw, and leaves a cpu% shell.
	set timeout $session_window
	expect {
		-re {password mismatch} {
			puts stderr "RIO-FAIL no-session — the auth exchange rejected the password (mismatch line on the pty; creds file: $creds_file)"
			cleanup
			exit 1
		}
		-re {goodbye} {
			puts stderr "RIO-FAIL drawterm-exited — drawterm exited before a shell prompt (goodbye on the pty)"
			cleanup
			exit 1
		}
		-re {cpu% } {
			puts stderr "rio-gate: stage ok — control session prompt (cpu% shell; the profile skipped rio)"
		}
		timeout {
			puts stderr "RIO-FAIL no-session — no cpu% shell prompt after the password feed"
			cleanup
			exit 1
		}
		eof {
			puts stderr "RIO-FAIL drawterm-exited — drawterm died during the auth/session start (pty EOF)"
			cleanup
			exit 1
		}
	}
}

# --- 7. the serial console: init's rc handoff after cpurc: DONE --------
set spawn_id $qemu_sid
set timeout 120
expect {
	-re {% } {
		puts stderr "rio-gate: stage ok — serial console rc prompt (init's handoff after cpurc: DONE)"
	}
	timeout {
		puts stderr "RIO-FAIL no-session — the serial console never reached an rc prompt after cpurc: DONE"
		cleanup
		exit 1
	}
	eof {
		puts stderr "RIO-FAIL no-session — qemu exited before the serial console reached an rc prompt"
		cleanup
		exit 1
	}
}

# --- 8. the rio stage budget, then `ls /srv` on the serial console -----
# The console shell is a plain rc (init's rcexec without -l: no profile),
# so its prompt is rcmain's default `% '.  rio's srv files land in the
# kernel-wide #s table; this namespace has #s bound at /srv by
# /lib/namespace (s3/evidence/static-analysis.md, A5).
set timeout $rio_budget
expect {
	timeout {
		puts stderr "rio-gate: stage ok — rio budget elapsed ($rio_budget s)"
	}
	eof {
		puts stderr "RIO-FAIL no-session — qemu exited while rio was starting"
		cleanup
		exit 1
	}
}

set found_rio 0
set found_wctl 0
set found_marker 0
set marker_pid ""
set chunk ""
if {$diag_mode} {
	set diag_marker_name [file tail $env(RIO_DIAG_MARKER)]
	set diag_pid_prefix [file tail $env(RIO_DIAG_PID_PREFIX)]
	set diag_pid_re "^[string map {. \\.} $diag_pid_prefix](\[0-9\]+)\$"
}
set timeout $srv_poll_wait
for {set i 0} {$i < $srv_polls} {incr i} {
	send -- "ls /srv\r"
	expect {
		-re {% } {
			set chunk $expect_out(buffer)
			foreach tok [split $chunk] {
				set tok [string trim $tok "\r\n"]
				if {[regexp {^riowctl\.[^ ]+\.[0-9]+$} $tok]} {
					set found_wctl 1
					continue
				}
				if {[regexp {^rio\.[^ ]+\.[0-9]+$} $tok]} {
					set found_rio 1
					continue
				}
				if {$diag_mode} {
					# The marker is an #s service entry: presence in
					# the listing is the signal; an unposted entry
					# cannot be read (port/src/devsrv.rs).
					if {$tok eq $diag_marker_name} {
						set found_marker 1
						continue
					}
					if {[regexp $diag_pid_re $tok -> mpid]} {
						set marker_pid $mpid
					}
				}
			}
		}
		timeout {
			set chunk ""
			puts stderr "rio-gate: note — `ls /srv' poll [expr {$i + 1}] timed out; retrying"
		}
		eof {
			puts stderr "RIO-FAIL no-session — qemu exited during the /srv poll"
			cleanup
			exit 1
		}
	}
	if {$rio_mode} {
		if {$found_rio && $found_wctl} { break }
	} else {
		if {$found_rio} { break }
	}
}

if {$diag_mode} {
	# The login verdict.  Marker present = the authenticated cpu profile
	# reached its guarded rio handoff (draw device present, plumber up);
	# absent = the X11 feed never reached the profile.  Presence-only:
	# no PASS is recorded from the marker, and the pair check below still
	# decides RIO-SERVING.
	if {$found_marker} {
		if {$marker_pid ne ""} {
			puts stderr "rio-gate: diag marker — $env(RIO_DIAG_MARKER) and $env(RIO_DIAG_PID_PREFIX)$marker_pid present in the serial /srv listing (profile shell pid $marker_pid)"
		} else {
			puts stderr "rio-gate: diag marker — $env(RIO_DIAG_MARKER) present in the serial /srv listing; no r9-login-pid.<pid> entry seen"
		}
		puts "RIO-DIAG login-ok"
	} else {
		puts stderr "rio-gate: diag marker — no $env(RIO_DIAG_MARKER) entry in the serial /srv listing (the login never reached the profile's rio handoff)"
		puts "RIO-FAIL login-not-reached"
	}
}

if {$rio_mode} {
	if {$found_rio && $found_wctl} {
		puts stderr "rio-gate: stage ok — serial /srv shows rio and riowctl (D-28 marker)"
		puts "RIO-SERVING"
	} else {
		puts stderr "RIO-FAIL rio-not-serving — no rio.<user>.<pid> + riowctl.<user>.<pid> pair in the serial /srv listing within the budget"
		cleanup
		exit 1
	}
} else {
	if {$found_rio} {
		puts stderr "RIO-FAIL control-saw-rio — a rio srv entry appeared in the -G control session, so the assertion does not discriminate"
		cleanup
		exit 1
	}
	puts "RIO-CONTROL-NO-RIO"
}

# --- 9. the whole-file post-passes -------------------------------------
log_file                           ;# stop + flush before the whole-file scan
set fh [open $env(RIO_SMOKE_LOG) r]
set whole [read $fh]
close $fh
if {[string first "cpurc: FAIL" $whole] >= 0} {
	puts stderr "rio-gate: cpurc: FAIL present in the capture — a ladder leg failed"
	cleanup
	exit 1
}
puts stderr "rio-gate: post-pass ok — zero cpurc: FAIL in the capture"
regsub -all {panic: sysfatal} $whole "" whole_nopanic
if {[string first "panic" $whole_nopanic] >= 0} {
	puts stderr "rio-gate: a panic marker is present in the capture"
	cleanup
	exit 1
}
puts stderr "rio-gate: post-pass ok — zero kernel panic markers (drawterm's own sysfatal exit pair excluded)"

# --- 10. the password redaction (LAST, after every assert ran) ----------
set pw_count 0
set pos 0
while {1} {
	set idx [string first $dt_pw $whole $pos]
	if {$idx < 0} { break }
	incr pw_count
	set pos [expr {$idx + [string length $dt_pw]}]
}
set redacted [string map [list $dt_pw "<demo-pw-redacted>"] $whole]
set fh [open $env(RIO_SMOKE_LOG) w]
puts -nonewline $fh $redacted
puts $fh "\nrio-gate: redaction contract held — <demo-pw-redacted> ($pw_count occurrence(s) of the per-bake DEMO password mapped; T-01-30)"
close $fh
puts stderr "rio-gate: post-pass ok — the per-bake DEMO password redacted from the retained capture ($pw_count occurrence(s) mapped)"

cleanup
if {$rio_mode} {
	if {$diag_mode} {
		puts stderr "rio-gate: ALL STAGES PASS — cpu boot to cpurc: DONE, encrypted drawterm session, serial /srv shows the rio-diag login marker and rio + riowctl (RIO-SERVING); diagnostic evidence in $env(RIO_OUT)"
	} else {
		puts stderr "rio-gate: ALL STAGES PASS — cpu boot to cpurc: DONE, encrypted drawterm session, serial /srv shows rio + riowctl (RIO-SERVING)"
	}
} else {
	puts stderr "rio-gate: ALL STAGES PASS — cpu boot to cpurc: DONE, -G control session, serial /srv shows no rio entry (RIO-CONTROL-NO-RIO)"
}
exit 0
