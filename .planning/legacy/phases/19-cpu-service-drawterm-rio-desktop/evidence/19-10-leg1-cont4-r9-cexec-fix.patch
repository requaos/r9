diff --git a/port/src/fdgrp.rs b/port/src/fdgrp.rs
index 6e2c5ff..3b23f1c 100644
--- a/port/src/fdgrp.rs
+++ b/port/src/fdgrp.rs
@@ -74,6 +74,24 @@ impl<const N: usize> FdGroup<N> {
